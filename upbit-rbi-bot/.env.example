# 업비트 Open API 키 (헌장 §9.6: 출금 권한 미부여, 절대 커밋 금지)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 텔레그램 알림 (헌장 §9.5, §10.2) — 선택
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 운영 모드
DRY_RUN=true            # true=모의(기본, 안전), false=실거래
LOOP_INTERVAL_SEC=10
FEED_STALE_SEC=60       # 가격 피드 정지 감시 (§9.4)

# 로깅
LOG_DIR=logs
DB_PATH=logs/trades.sqlite
