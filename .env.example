# ── 실행 모드 ────────────────────────────────────────────────
# 사용자 지시: 백테스트 생략, 바로 실전. 실전은 DRY_RUN=false + 업비트 키 필수.
# (안전 기본값은 코드상 true. 실전 전환 시 아래를 false 로.)
DRY_RUN=false

# ── 업비트 Open API 키 (헌장 §9.6: 출금 권한 미부여, 커밋 금지) ──
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ── 대시보드 킬 스위치 토큰 (POST /life-change/api/kill 보호) ──
DASHBOARD_TOKEN=change-me

# ── 텔레그램 알림 (헌장 §9.5, §10.2) — 선택 ──
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── 운영 파라미터 ────────────────────────────────────────────
LOOP_INTERVAL_SEC=10
FEED_STALE_SEC=60
LOG_DIR=logs
DB_PATH=logs/trades.sqlite
