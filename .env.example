# ── 실행 모드 ────────────────────────────────────────────────
# 실거래에는 **두 개**가 모두 필요하다 (헌장 §9.7, v1.3):
#   1) DRY_RUN=false
#   2) LIVE_CHARTER_ACK=<현재 헌장 버전>   ← 없으면 자동으로 모의 모드로 강제된다
# 매매 규칙이 개정될 때마다 이 승인을 다시 해야 한다. 전략이 바뀐 코드가 배포됐는데
# 이전 승인으로 실계좌가 계속 도는 것을 막기 위한 장치다.
DRY_RUN=false

# 헌장 v1.4 규칙(rsi2 5분+15분 병행 · 스프레드 필터 · 동시 3포지션)을 승인하는 값.
# 값이 없거나 버전이 다르면 자동으로 모의 모드가 된다.
LIVE_CHARTER_ACK=

# ── 업비트 Open API 키 (헌장 §9.6: 출금 권한 미부여, 커밋 금지) ──
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ── 대시보드 킬 스위치 토큰 (POST /life-change/api/kill 보호) ──
DASHBOARD_TOKEN=change-me

# ── 텔레그램 알림 (헌장 §9.5, §10.2) — 선택 ──
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── 운영 파라미터 ────────────────────────────────────────────
LOOP_INTERVAL_SEC=10
FEED_STALE_SEC=60
LOG_DIR=logs
DB_PATH=logs/trades.sqlite
